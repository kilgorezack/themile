rules_version = '2';

// Milecast / The Mile — one account shared by the website and the iOS app.
// Profiles live at users/{uid}. Each user can read and write only their own,
// with every field type- and size-checked. `plan` (free | one) and `tier`
// (free | one_monthly | one_annual) are written only by the server (Admin SDK:
// the App Store functions), never by clients.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function optString(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    function validFishing(f) {
      return f is map
        && f.keys().hasOnly(['methods', 'styles', 'experience', 'frequency', 'isGuide', 'homeBase'])
        && (!('methods' in f) || (f.methods is list && f.methods.size() <= 3 && f.methods.hasOnly(['fly', 'spin', 'bait'])))
        && (!('styles' in f) || (f.styles is list && f.styles.size() <= 3 && f.styles.hasOnly(['wade', 'boat', 'bank'])))
        && (!('experience' in f) || f.experience in ['new', 'some', 'lifer'])
        && (!('frequency' in f) || f.frequency in ['few', 'monthly', 'weekly'])
        && (!('isGuide' in f) || f.isGuide is bool)
        && optString(f, 'homeBase', 80);
    }

    function validAlerts(a) {
      return a is map
        && a.keys().hasOnly(['flow', 'calm', 'lightning', 'outlook'])
        && (!('flow' in a) || a.flow is bool)
        && (!('calm' in a) || a.calm is bool)
        && (!('lightning' in a) || a.lightning is bool)
        && (!('outlook' in a) || a.outlook is bool);
    }

    function validProfile(d) {
      return d.keys().hasOnly([
          'firstName', 'lastName', 'displayName', 'email', 'photoURL',
          'fishing', 'alerts', 'dashboardLayout',
          'createdVia', 'createdAt', 'updatedAt', 'onboardedAt', 'plan', 'tier'
        ])
        && optString(d, 'firstName', 60)
        && optString(d, 'lastName', 60)
        && optString(d, 'displayName', 121)
        && optString(d, 'email', 254)
        && (!('photoURL' in d) || d.photoURL == null || (d.photoURL is string && d.photoURL.size() <= 2048))
        && (!('fishing' in d) || validFishing(d.fishing))
        && (!('alerts' in d) || validAlerts(d.alerts))
        && (!('dashboardLayout' in d) || d.dashboardLayout is map)
        && (!('createdVia' in d) || d.createdVia in ['ios', 'web'])
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp)
        && (!('onboardedAt' in d) || d.onboardedAt is timestamp)
        // Server-set: free, one_monthly or one_annual.
        && (!('tier' in d) || d.tier in ['free', 'one_monthly', 'one_annual']);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && !('plan' in request.resource.data)
        && !('tier' in request.resource.data);

      // createdAt / createdVia are set once; plan and tier only ever change server-side.
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'tier', 'createdAt', 'createdVia']);

      allow delete: if isOwner(uid);
    }

    // App Store subscription as the iOS app last saw it, including Apple's
    // signed transaction (`jws`). This is a record only: it never grants
    // anything. The verifyAppStorePurchase function (functions/src/appStore.ts) checks `jws` with Apple and then sets `plan` on the
    // profile, which clients still can't write.
    function validAppStore(d) {
      return d.keys().hasOnly([
          'productId', 'isActive', 'transactionId', 'originalTransactionId',
          'purchaseDate', 'originalPurchaseDate', 'expirationDate',
          'environment', 'ownershipType', 'appAccountToken', 'jws', 'updatedAt'
        ])
        && d.productId in ['one.milecast.monthly', 'one.milecast.yearly']
        && d.isActive is bool
        && d.transactionId is string && d.transactionId.size() <= 64
        && d.originalTransactionId is string && d.originalTransactionId.size() <= 64
        && d.purchaseDate is timestamp
        && d.originalPurchaseDate is timestamp
        && (!('expirationDate' in d) || d.expirationDate is timestamp)
        && d.environment is string && d.environment.size() <= 32
        && d.ownershipType is string && d.ownershipType.size() <= 32
        && (!('appAccountToken' in d) || (d.appAccountToken is string && d.appAccountToken.size() <= 64))
        && d.jws is string && d.jws.size() <= 20000
        && d.updatedAt == request.time;
    }

    match /users/{uid}/subscriptions/{store} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && store == 'appStore' && validAppStore(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // Push notification devices: one document per FCM registration token,
    // written by the app on this device and read only by the alert sender
    // (Admin SDK). Removed on sign-out.
    function validDevice(d, token) {
      return d.keys().hasOnly(['token', 'platform', 'appVersion', 'tz', 'updatedAt'])
        && d.token == token
        && d.platform in ['ios', 'web']
        && optString(d, 'appVersion', 32)
        && optString(d, 'tz', 64)
        && d.updatedAt == request.time;
    }

    match /users/{uid}/devices/{token} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && token.size() <= 4096 && validDevice(request.resource.data, token);
    }

    // A push the iOS app received from outside the alert sender (e.g. a
    // Firebase console campaign), saved by the app under `push-<message id>`.
    function validReceivedPush(d) {
      return d.keys().hasOnly(['kind', 'title', 'body', 'link', 'read', 'createdAt'])
        && d.kind == 'message'
        && d.title is string && d.title.size() <= 200
        && d.body is string && d.body.size() <= 4000
        && optString(d, 'link', 500)
        && d.read is bool
        && d.createdAt is timestamp && d.createdAt <= request.time;
    }

    // Notification inbox: a copy of each alert sent to this person, written
    // by the alert sender (Admin SDK), plus pushes the app received from
    // elsewhere. The owner can read, delete, and flip `read`; the app can
    // add received pushes, and nothing else.
    match /users/{uid}/notifications/{id} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && id.matches('push-[A-Za-z0-9:_.-]{1,200}')
        && validReceivedPush(request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
    }

    // Everything else is closed unless a rule above opens it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
