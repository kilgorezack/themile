rules_version = '2';

// Profile photos: users/{uid}/avatar.jpg. The apps crop to a square, shrink to
// 512 px and compress to JPEG before upload; these rules enforce the result.
service firebase.storage {
  match /b/{bucket}/o {

    match /users/{uid}/avatar.jpg {
      // Any signed-in Milecast user can see avatars (account menus, future shared features).
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
