# ── Tempest (WeatherFlow) ──────────────────────────────────────────────
# Personal access token: tempestwx.com → Settings → Data Authorizations
TEMPEST_TOKEN=
# Station ID: the number in your tempestwx.com/station/<ID> URL
TEMPEST_STATION_ID=

# ── Weather Underground (fallback if Tempest is not set / unreachable) ─
# PWS API key: wunderground.com → My Profile → API Keys
WU_API_KEY=
# Your PWS station ID, e.g. KWYSINCL12
WU_STATION_ID=

# ── Optional ───────────────────────────────────────────────────────────
# Contact string sent in the User-Agent to api.weather.gov (NWS asks for one)
NWS_CONTACT=mile.fish

# ── Apple Maps satellite view (see docs/apple-maps.md) ─────────────────
APPLE_MAPKIT_TEAM_ID=
APPLE_MAPKIT_KEY_ID=
# Paste the whole .p8 file contents (BEGIN/END lines included)
APPLE_MAPKIT_PRIVATE_KEY=

# ── Firebase App Check (website) ───────────────────────────────────────
# reCAPTCHA Enterprise site key (public). Google Cloud → Security →
# reCAPTCHA → Keys. Leave empty to run without App Check.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
